[Unit]
Description=AI Gateway Control Server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/common_games/local-ai-gateway
EnvironmentFile=-%h/.config/local-ai-gateway/gateway.env
ExecStart=%h/.local/bin/uvicorn control_server:app --host ${CONTROL_HOST} --port ${CONTROL_PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
